	CONSTANTS
		MSG_INPUT <- "Introduce a value: "
		MSG_OK <- "Correct data"
		MSG_WRONG <- "Incorrect data"
	VARIABLES
		aux: BOOLEAN
		value, tries, average, i, tempAnt: INTEGER
	BEGIN
		tries <- 2
		aux <- false
		
		DO
			i <- 0
			tempAnt <- 25
			average <- 0
			DO
				WRITE MSG_INPUT
				READ value
				IF (value <= 35) AND (value >= 15) THEN
					aux <- true
				ENDIF
				
